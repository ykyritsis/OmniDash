{
  "name": "xbox-preview-ui",
  "version": "0.7.3",
  "private": true,
  "description": "OmniDash — a controller-first Windows game launcher with console-inspired themes.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node scripts/run-tests.cjs",
    "test:unit": "node scripts/run-tests.cjs --unit",
    "test:electron": "node scripts/run-tests.cjs --electron",
    "audit:static": "node scripts/audit-static.cjs",
    "profile:startup": "electron scripts/startup-profile.cjs",
    "profile:startup:stalls": "electron scripts/startup-stalls-profile.cjs",
    "profile:startup:cold": "electron scripts/startup-cold-profile.cjs",
    "prepare:native": "node scripts/prepare-native.cjs",
    "predist": "node scripts/prepare-native.cjs",
    "predist:portable": "node scripts/prepare-native.cjs",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "44.9.3",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@10.34.7",
  "pnpm": {
    "overrides": {
      "undici@>=4 <6.29.1": "6.29.1",
      "fast-uri@>=3 <3.1.9": "3.1.9"
    }
  },
  "build": {
    "appId": "com.nebula.pclauncher",
    "productName": "OmniDash",
    "asarUnpack": ["src/xbox-mode-bridge/**"],
    "extraResources": [{ "from": ".packaging-staging/native", "to": "native", "filter": ["**/*"] }],
    "compression": "maximum",
    "files": [
      "src/**/*",
      "!src/**/*.cs",
      "!src/**/README.md",
      "build/icon.svg",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "OmniDash-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "OmniDash-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
