{
  "name": "xbox-preview-ui",
  "version": "0.27.0-beta.15",
  "private": true,
  "description": "A controller-first Windows game launcher inspired by the Xbox console dashboard.",
  "main": "src/main.cjs",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --win nsis",
    "dist:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^39.2.7",
    "electron-builder": "^26.0.12"
  },
  "dependencies": {
    "yaml": "2.9.1"
  },
  "build": {
    "appId": "com.nebula.pclauncher",
    "productName": "Xbox Preview UI",
    "asarUnpack": ["src/xbox-mode-bridge/**"],
    "files": [
      "src/**/*",
      "build/icon.svg",
      "build/icon.png",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "Xbox-Preview-UI-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Xbox-Preview-UI-Portable-${version}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
